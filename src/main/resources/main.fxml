<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="650.0" minWidth="900.0" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="agh.ics.oop.presenter.MainPresenter">
    <center>
        <VBox alignment="CENTER" spacing="25.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="30.0" right="40.0" bottom="30.0" left="40.0" />
            </padding>
            <children>

                <Label styleClass="main-header" text="Simulation Configuration" />
                <HBox alignment="CENTER" spacing="25.0">
                    <children>

                        <VBox prefWidth="260.0" spacing="15.0" styleClass="config-card">
                            <children>
                                <Label styleClass="section-label-green" text="Environment and Map" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Map Width" styleClass="param-label" prefWidth="120.0"/>
                                    <Spinner fx:id="mapWidth" styleClass="split-arrows-horizontal" initialValue="10" editable="true" min="1" max="100" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Map Height" styleClass="param-label" prefWidth="120.0"/>
                                    <Spinner fx:id="mapHeight" styleClass="split-arrows-horizontal" initialValue="10" editable="true" min="1" max="100" prefWidth="90.0" />
                                </HBox>

                                <Separator styleClass="custom-separator" />

                                <Label styleClass="subsection-label-green" text="Grass" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Initial grass amount" styleClass="param-label" prefWidth="120.0" wrapText="true"/>
                                    <Spinner fx:id="initialGrassAmount" styleClass="split-arrows-horizontal" initialValue="40" editable="true" min="0" max="1000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Daily grass growth" styleClass="param-label" prefWidth="120.0"/>
                                    <Spinner fx:id="dailyGrassGrowth" styleClass="split-arrows-horizontal" initialValue="15" editable="true" min="0" max="1000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Grass energy" styleClass="param-label" prefWidth="120.0"/>
                                    <Spinner fx:id="grassEnergy" styleClass="split-arrows-horizontal" initialValue="5" max="1000" prefWidth="90.0" />
                                </HBox>
                            </children>
                        </VBox>

                        <VBox prefWidth="280.0" spacing="15.0" styleClass="config-card">
                            <children>
                                <Label styleClass="section-label-red" text="Animals" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Initial animal amount" styleClass="param-label" prefWidth="140.0" wrapText="true"/>
                                    <Spinner fx:id="initialAnimalAmount" styleClass="split-arrows-horizontal" initialValue="10" editable="true" min="1" max="10000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Initial animal energy" styleClass="param-label" prefWidth="140.0"/>
                                    <Spinner fx:id="initialAnimalEnergy" styleClass="split-arrows-horizontal" initialValue="10" editable="true" min="1" max="10000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Daily energy loss" styleClass="param-label" prefWidth="140.0"/>
                                    <Spinner fx:id="dailyEnergyLoss" styleClass="split-arrows-horizontal" initialValue="1" editable="true" min="-10000" max="10000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Reproduction ready energy" styleClass="param-label" prefWidth="140.0" wrapText="true"/>
                                    <Spinner fx:id="reproductionReadyEnergy" styleClass="split-arrows-horizontal" initialValue="2" editable="true" min="0" max="10000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Copulation energy loss" styleClass="param-label" prefWidth="140.0" wrapText="true"/>
                                    <Spinner fx:id="copulationEnergyLoss" styleClass="split-arrows-horizontal" initialValue="4" max="10000" prefWidth="90.0" />
                                </HBox>
                            </children>
                        </VBox>

                        <VBox prefWidth="280.0" spacing="15.0" styleClass="config-card">
                            <children>
                                <Label styleClass="section-label-purple" text="Genome and Mutations" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Min mutation amount" styleClass="param-label" prefWidth="140.0" wrapText="true"/>
                                    <Spinner fx:id="minimumMutationAmount" styleClass="split-arrows-horizontal" initialValue="2" editable="true" min="0" max="1000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Max mutation amount" styleClass="param-label" prefWidth="140.0" wrapText="true"/>
                                    <Spinner fx:id="maximumMutationAmount" styleClass="split-arrows-horizontal" initialValue="5" max="1000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Genome length" styleClass="param-label" prefWidth="140.0"/>
                                    <Spinner fx:id="genomeLength" styleClass="split-arrows-horizontal" initialValue="10" editable="true" min="1" max="1000" prefWidth="90.0" />
                                </HBox>

                                <Separator styleClass="custom-separator" />

                                <CheckBox fx:id="fastAnimals" mnemonicParsing="false" styleClass="fast-animals-checkbox" text="Fast Animals" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Speed activation th." styleClass="param-label" prefWidth="140.0" wrapText="true"/>
                                    <Spinner fx:id="fastAnimalsEnergyThreshold" styleClass="split-arrows-horizontal" initialValue="5" editable="true" min="0" max="1000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Speed increase th." styleClass="param-label" prefWidth="140.0" wrapText="true"/>
                                    <Spinner fx:id="fastAnimalsSpeedIncreaseThreshold" styleClass="split-arrows-horizontal" initialValue="2" editable="true" min="1" max="1000" prefWidth="90.0" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Maximum speed" styleClass="param-label" prefWidth="140.0"/>
                                    <Spinner fx:id="fastAnimalsMaxSpeed" styleClass="split-arrows-horizontal" initialValue="8" editable="true" min="1" max="1000" prefWidth="90.0" />
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox alignment="CENTER" spacing="10.0">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                    <children>
                        <Button fx:id="startButton" onAction="#onSimulationStartClicked" prefWidth="250.0" prefHeight="50.0" styleClass="btn-start" text="BEGIN SIMULATION"/>
                        <Label fx:id="invalidMovesMessage" styleClass="error-label" />
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>
</BorderPane>